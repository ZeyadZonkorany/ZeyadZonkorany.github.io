---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { monogramPath } from '../lib/identity';
---
<Base title="About — Zonkor" description="Zonkor is a security researcher, penetration tester, and CTF player focused on web security and vulnerability research.">
  <section class="page-intro"><span class="eyebrow">PROFILE</span><h1>About<span class="accent">.</span></h1></section>
  <div class="profile-layout"><div class="profile-art" aria-hidden="true"><svg viewBox="0 0 360 460" fill="none"><path d="M0 0H360V460H0Z" fill="var(--surface)" /><path d="M0 115H360M0 230H360M0 345H360M90 0V460M180 0V460M270 0V460" stroke="var(--line)"/><path transform="translate(96 80) scale(1.2)" d={monogramPath} fill="var(--accent)"/><path d="M0 220H360V231H0Z" fill="var(--bg)" /></svg></div><section class="about-bio"><h2>Zonkor</h2><p>I’m a penetration tester and security researcher focused on web security and vulnerability research. I play CTFs and build challenges.</p><p>I publish research, writeups, and technical notes here. My public projects are on GitHub.</p><a class="text-link" href="https://github.com/ZeyadZonkorany" target="_blank" rel="noopener noreferrer">ZeyadZonkorany on GitHub <Icon name="external" size={18} /></a><div class="about-details"><section><h3>Focus</h3><ul><li>Web security</li><li>Vulnerability research</li><li>CTF challenges & writeups</li></ul></section><section><h3>CTF teams</h3><ul><li>0xL4ugh</li><li>Project Sekai</li><li>FMC</li><li>P1G SEKAI</li></ul></section></div></section></div>
</Base>
