---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Wordmark from '../components/Wordmark.astro';
import { monogramPath } from '../lib/identity';
import Poster from '../components/Poster.astro';
import { researchReferences } from '../lib/references';
import { publishedPosts, formatDate, readingTime } from '../lib/posts';
const posts = await publishedPosts();
const writeups = posts.filter((post) => post.data.category === 'CTF').slice(0, 2);
const research = [
  ...researchReferences.map((item) => ({ ...item, date: item.added, external: true, meta: `Reference · ${item.source}` })),
  ...posts.filter((post) => post.data.category === 'Research').map((post) => ({ title: post.data.title, href: `/writing/${post.id}/`, category: post.data.category, date: post.data.date.toISOString(), cover: 'note' as const, external: false, meta: `${formatDate(post.data.date)} · ${readingTime(post)} min read` })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 2);
---
<Base>
  <section class="masthead" aria-label="Zonkor">
    <div class="masthead-label mono"><span>Security research</span><span>Web / CTF</span></div>
    <div class="hero-composition">
      <div class="hero-copy">
        <h1 class="display-name"><span class="sr-only">Zonkor.</span><Wordmark display /></h1>
        <p class="hero-description">Web security researcher.<br />CTF player.</p>
        <div class="hero-actions"><a class="hero-pill" href="/writing/">Browse writing <Icon name="arrow" size={19} /></a><a class="hero-project-link" href="/projects/">Projects <Icon name="external" size={17} /></a></div>
      </div>
      <figure class="hero-object" aria-hidden="true">
        <svg class="object-fallback" viewBox="0 0 280 360" fill="none"><g transform="translate(70 42)"><path d={monogramPath} fill="var(--accent)" /><path d="M0 116H140V124H0Z" fill="var(--bg)" /></g></svg>
        <canvas id="hero-sculpture"></canvas>
      </figure>
    </div>
  </section>
  <section class="research-section" aria-labelledby="research-heading">
    <div class="section-heading"><h2 id="research-heading">Research</h2><span class="mono">{String(research.length).padStart(2, '0')} entries</span></div>
    <div class="research-spread">{research.map((item, index) => <a class:list={['research-feature', `feature-${index + 1}`]} href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}><div class="cover"><Poster kind={item.cover} /><span class="cover-open"><Icon name="external" size={28} /></span></div><div class="feature-meta mono"><span>{String(index + 1).padStart(2, '0')} / Research</span><span>{item.meta}</span></div><h3>{item.title}</h3></a>)}</div>
  </section>
  {writeups.length > 0 && <section class="ctf-section" aria-labelledby="ctf-heading">
    <div class="section-heading"><h2 id="ctf-heading">CTF writeups</h2><a class="ctf-all mono" href="/writing/?category=CTF">All writeups <Icon name="arrow" size={17} /></a></div>
    <div class="ctf-list">{writeups.map((post) => <a class="ctf-preview" href={`/writing/${post.id}/`}><div class="ctf-cover"><Poster kind={post.data.cover} /></div><div class="ctf-copy"><span class="eyebrow">{post.data.event ?? 'CTF'} · {readingTime(post)} min read</span><h3>{post.data.title.split(' — ')[0]}</h3><p>{post.data.description}</p></div><Icon name="arrow" size={24} /></a>)}</div>
  </section>}
</Base>
