---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { researchReferences } from '../lib/references';
import { publishedPosts, formatDate } from '../lib/posts';
const posts = await publishedPosts();
const recent = [
  ...researchReferences.map((item) => ({ title: item.title, href: item.href, category: item.category, meta: `Reference · ${item.source}`, date: item.added, external: true })),
  ...posts.map((post) => ({ title: post.data.title, href: `/writing/${post.id}/`, category: post.data.category, meta: formatDate(post.data.date), date: post.data.date.toISOString(), external: false })),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 3);
---
<Base>
  <section class="home-intro">
    <div class="intro-copy"><span class="eyebrow">WEB SECURITY & CTF</span><h1>Zonkor<span class="accent">.</span></h1><p>Web security researcher and CTF player.<br />Research, writeups, and technical notes.</p><a class="text-link" href="/writing/">Browse writing <Icon name="arrow" size={17} /></a></div>
    <div class="profile-mark" aria-hidden="true"><span>z</span><span class="mark-corner">01</span></div>
  </section>
  <div class="topic-line"><span>Web security</span><span>Vulnerability research</span><span>CTF</span></div>
  <section class="recent-section" aria-labelledby="recent-heading"><div class="section-heading"><h2 id="recent-heading">Recent writing</h2><a href="/writing/" class="subtle-link">View all <Icon name="arrow" size={15} /></a></div><div class="recent-list">{recent.map((item) => <a class="recent-entry" href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}><div class="recent-meta"><span class:list={['category-label', { research: item.category === 'Research' }]}>{item.category}</span><span>{item.meta}</span></div><div class="recent-title"><h3>{item.title}</h3><Icon name={item.external ? 'external' : 'arrow'} size={19} /></div></a>)}</div></section>
</Base>
