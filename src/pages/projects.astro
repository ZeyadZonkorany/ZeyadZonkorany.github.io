---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Poster from '../components/Poster.astro';
const projects = [
  { name: 'My CTF challenges', description: 'A collection of public CTF challenges.', href: 'https://github.com/ZeyadZonkorany/MY-CTF-CHALLENGES', repo: 'MY-CTF-CHALLENGES', tag: 'CTF', cover: 'ctf' as const },
  { name: '0xL4ugh CTF 2025', description: 'Web challenges from 0xL4ugh CTF 2025.', href: 'https://github.com/ZeyadZonkorany/0xL4ugh-CTF-2025-Web', repo: '0xL4ugh-CTF-2025-Web', tag: 'Web security', cover: 'web' as const },
];
---
<Base title="Projects — Zonkor" description="Public CTF challenge repositories by Zonkor.">
  <section class="page-intro"><span class="eyebrow">PUBLIC REPOSITORIES</span><h1>Projects<span class="accent">.</span></h1><p>CTF challenges and web security projects.</p></section>
  <section class="project-list" aria-label="Public projects">{projects.map((project, index) => <a class="project-card" href={project.href} target="_blank" rel="noopener noreferrer"><span class="project-number mono">{String(index + 1).padStart(2, '0')}</span><div class="project-copy"><span class="eyebrow">{project.tag}</span><h2>{project.name}</h2><p>{project.description}</p><span class="repo-name mono">{project.repo}</span></div><div class="project-art"><Poster kind={project.cover} /></div><Icon name="external" size={30} /></a>)}</section>
  <a class="text-link page-end-link" href="https://github.com/ZeyadZonkorany?tab=repositories" target="_blank" rel="noopener noreferrer">All repositories <Icon name="external" size={18} /></a>
</Base>
