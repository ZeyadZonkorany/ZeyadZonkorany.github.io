---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Poster from '../../components/Poster.astro';
import { publishedPosts, formatDate, readingTime } from '../../lib/posts';
import { researchReferences } from '../../lib/references';
const posts = await publishedPosts();
const entries = [
  ...researchReferences.map((item) => ({ ...item, description: 'External reference · ZeroSploit', meta: 'Reference · ZeroSploit', search: `${item.title} ${item.tags.join(' ')} ZeroSploit`, external: true })),
  ...posts.map((post) => ({ id: post.id, title: post.data.title, href: `/writing/${post.id}/`, category: post.data.category, cover: 'note' as const, description: post.data.description, tags: post.data.tags, meta: `${formatDate(post.data.date)} · ${readingTime(post)} min read`, search: `${post.data.title} ${post.data.description} ${post.data.tags.join(' ')} ${post.body ?? ''}`, external: false })),
];
const categories = ['All', 'Research', 'CTF', 'Notes'];
---
<Base title="Writing — Zonkor" description="Security research, CTF writeups, technical notes, and research references selected by Zonkor.">
  <section class="page-intro"><span class="eyebrow">ARTICLES & REFERENCES</span><div class="page-heading-line"><h1>Writing<span class="accent">.</span></h1><span class="entry-count mono">{entries.length} entries</span></div><p>Research, CTF writeups, and technical notes.</p></section>
  <section class="archive" aria-label="Writing archive"><div class="archive-controls"><div class="filter-group" role="group" aria-label="Filter by category">{categories.map((category) => <button type="button" class:list={['filter-button', { selected: category === 'All' }]} data-category={category} aria-pressed={category === 'All'}>{category}<span class="mono">{category === 'All' ? entries.length : entries.filter((entry) => entry.category === category).length}</span></button>)}</div><label class="search-box"><Icon name="search" size={17} /><span class="sr-only">Search articles</span><input type="search" id="article-search" placeholder="Search articles…" autocomplete="off" /><kbd aria-hidden="true">/</kbd></label></div>
    <div class="archive-meta"><span id="results-count" role="status" aria-live="polite">{entries.length} entries</span><span>External links open in a new tab ↗</span></div>
    <div class="archive-list">{entries.map((entry, index) => <article class="archive-entry" data-post-id={entry.id} data-post-category={entry.category} data-search={`${entry.search} ${entry.category}`.toLowerCase()}><a href={entry.href} target={entry.external ? '_blank' : undefined} rel={entry.external ? 'noopener noreferrer' : undefined}><span class="archive-number mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div class="archive-entry-content"><div class="entry-meta"><span class:list={['category-label', { research: entry.category === 'Research' }]}>{entry.category}</span><span>{entry.meta}</span></div><h2>{entry.title}</h2>{!entry.external && <p>{entry.description}</p>}<div class="archive-tags mono">{entry.tags.map((tag) => <span>#{tag}</span>)}</div></div><div class="archive-art"><Poster kind={entry.cover} /></div><Icon name={entry.external ? 'external' : 'arrow'} size={20} /></a></article>)}</div>
    <div id="no-results" class="empty-state" hidden><h2>No articles found.</h2><p>Try another category or search term.</p><button type="button" id="reset-search" class="text-link">Clear filters <Icon name="arrow" size={17} /></button></div>
    <noscript><p class="noscript-note">All entries are shown. Enable JavaScript to search and filter.</p></noscript>
    <a class="text-link page-end-link" href="/rss.xml" data-astro-reload>Subscribe to articles via RSS <Icon name="external" size={16} /></a>
  </section>
</Base>
