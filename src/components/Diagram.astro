---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---
<div class:list={['specimen', { compact }]} aria-hidden="true">
  <div class="specimen-label"><span>FIG. 01 / THE UNEXPECTED</span><span>↗</span></div>
  <svg class="specimen-art" viewBox="0 0 520 420" fill="none">
    <defs>
      <pattern id="grid" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0v26" stroke="currentColor" stroke-opacity=".10" stroke-width=".6" /></pattern>
      <pattern id="hatch" width="5" height="5" patternTransform="rotate(35)" patternUnits="userSpaceOnUse"><path d="M0 0v5" stroke="currentColor" stroke-opacity=".45" /></pattern>
    </defs>
    <rect x="0" y="0" width="520" height="420" fill="url(#grid)" />
    <path d="M260 20v380M48 210h424" stroke="currentColor" stroke-opacity=".35" stroke-dasharray="3 6" />
    <circle cx="260" cy="210" r="166" stroke="currentColor" stroke-opacity=".3" />
    <circle cx="260" cy="210" r="116" stroke="currentColor" stroke-opacity=".6" />
    <circle cx="260" cy="210" r="70" fill="url(#hatch)" stroke="currentColor" />
    <g class="orbit orbit-outer"><path d="M260 44a166 166 0 0 1 166 166" stroke="currentColor" stroke-width="3" /><circle cx="426" cy="210" r="6" fill="currentColor" /></g>
    <g class="orbit orbit-inner"><path d="M144 210a116 116 0 0 1 116-116" stroke="currentColor" stroke-width="2" /><rect x="256" y="90" width="8" height="8" fill="currentColor" /></g>
    <path d="M229 211h62m-31-31v62" stroke="currentColor" stroke-width="1.5" />
    <circle cx="260" cy="210" r="8" fill="currentColor" />
    <path d="m124 113-29-29H45m352 232 27 27h53" stroke="currentColor" stroke-opacity=".7" />
    <circle cx="124" cy="113" r="3" fill="currentColor" /><circle cx="397" cy="316" r="3" fill="currentColor" />
    <g fill="currentColor" font-family="monospace" font-size="10" letter-spacing="1"><text x="45" y="72">OBSERVE</text><text x="419" y="363">QUESTION</text><text x="272" y="37">01</text><text x="272" y="402">02</text></g>
    <path d="M20 20h12m-6-6v12m462 368h12m-6-6v12" stroke="currentColor" />
  </svg>
  <div class="specimen-foot"><span>SURFACE ≠ SYSTEM</span><span class="diagram-dot"></span><span>LOOK A LITTLE CLOSER</span></div>
</div>
