---
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import '@fontsource-variable/archivo';
import '@fontsource-variable/dm-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props { title?: string; description?: string; article?: boolean; }
const {
  title = 'Zonkor — Security research & field notes',
  description = 'The research journal of Zonkor. Web security, CTF writeups, and field notes from looking a little closer.',
  article = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#eeede6" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Zonkor’s research journal" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Zonkor. Look closer. Security research and field notes." />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem('zonkor-theme') || 'light';
          document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
        } catch { document.documentElement.dataset.theme = 'light'; }
        document.documentElement.classList.add('js');
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell" transition:name="site-header">
      <a class="wordmark" href="/" aria-label="Zonkor, home">zonkor<span class="wordmark-dot">.</span></a>
      <span class="header-caption mono">SECURITY RESEARCH<br />& FIELD NOTES</span>
      <nav aria-label="Main navigation" class="main-nav">
        <a class:list={['nav-link', { active: path.startsWith('/writing') }]} href="/writing/" aria-current={path.startsWith('/writing') ? 'page' : undefined}>Writing<span class="nav-index" aria-hidden="true">01</span></a>
        <a class:list={['nav-link', { active: path.startsWith('/about') }]} href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About<span class="nav-index" aria-hidden="true">02</span></a>
        <a class="nav-link github-nav" href="https://github.com/ZeyadZonkorany" target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" size={15} /></a>
      </nav>
      <button class="theme-toggle icon-button" type="button" aria-label="Switch to dark theme" title="Switch color theme">
        <span class="theme-moon"><Icon name="moon" size={18} /></span><span class="theme-sun"><Icon name="sun" size={18} /></span>
      </button>
    </header>
    <main id="main" class="shell" tabindex="-1"><slot /></main>
    <footer class="site-footer shell" transition:name="site-footer">
      <div class="footer-top"><a href="/" class="footer-wordmark">zonkor.</a><p>Stay curious.<br />Look closer.</p><a class="footer-contact" href="https://github.com/ZeyadZonkorany" target="_blank" rel="noopener noreferrer">Find me on GitHub <Icon name="external" size={26} /></a></div>
      <div class="footer-bottom mono"><span>© {new Date().getUTCFullYear()} ZONKOR</span><span>INDEPENDENT SECURITY RESEARCH</span><div><a href="/rss.xml" data-astro-reload>RSS FEED ↗</a><a href="#main">BACK TO TOP ↑</a></div></div>
    </footer>
    <div class="toast mono" role="status" aria-live="polite"></div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
